{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // ponytail: Node 25 type-stripping requires the explicit ".ts" extension on
    // relative imports; tsc rejects it without this flag. Keeps `node --test`
    // and `next build` agreeing on one import style.
    "allowImportingTsExtensions": true,
    // Node runs .ts in strip-only mode: it erases annotations and emits no new
    // code. Parameter properties, enums and namespaces require codegen, so they
    // throw ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX at import time under `node --test`
    // while compiling fine under Next/SWC. This makes tsc reject them up front.
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
